{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "esquema": {
      "type": "string",
      "const": "versologia-ficha-minima/0.2"
    },
    "obra_ref": {
      "type": "string",
      "minLength": 1
    },
    "metadatos": {
      "type": "object",
      "properties": {
        "titulo": {
          "type": "string",
          "minLength": 1
        },
        "autor_nombre": {
          "type": "string",
          "minLength": 1
        },
        "genero": {
          "type": "string",
          "minLength": 1
        },
        "edicion_base": {
          "type": "string",
          "minLength": 1
        },
        "fecha_inicio": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 2147483647
        },
        "fecha_fin": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 2147483647
        },
        "fuente_fecha": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "fundamento_autoria": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "observaciones": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "titulo",
        "autor_nombre",
        "genero",
        "edicion_base",
        "fecha_inicio",
        "fecha_fin",
        "fuente_fecha",
        "fundamento_autoria",
        "observaciones"
      ],
      "additionalProperties": false
    },
    "jornadas": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "numero": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 2147483647
          },
          "v_ini": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 2147483647
          },
          "v_fin": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 2147483647
          },
          "rotulo_literal": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "numero",
          "v_ini",
          "v_fin",
          "rotulo_literal"
        ],
        "additionalProperties": false
      }
    },
    "segmentos": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "v_ini": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 2147483647
          },
          "v_fin": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 2147483647
          },
          "segmentacion": {
            "type": "string",
            "enum": [
              "provisional",
              "confirmada"
            ]
          },
          "origen": {
            "type": "object",
            "properties": {
              "tramo_ref": {
                "type": "string",
                "minLength": 1
              },
              "denominacion_literal": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "fuente_id": {
                "type": "string",
                "minLength": 1
              },
              "pagina": {
                "anyOf": [
                  {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 2147483647
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "notas_ref": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "tramo_ref",
              "denominacion_literal",
              "fuente_id",
              "pagina",
              "notas_ref"
            ],
            "additionalProperties": false
          },
          "identificacion": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "forma_slug": {
                    "type": "string",
                    "minLength": 1
                  },
                  "arquitectura_slug": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "forma_slug",
                  "arquitectura_slug"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "candidatas": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "forma_slug": {
                  "type": "string",
                  "minLength": 1
                },
                "arquitectura_slug": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "forma_slug",
                "arquitectura_slug"
              ],
              "additionalProperties": false
            }
          },
          "regla_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "nota": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "detalles_fuente": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "literal": {
                      "type": "string",
                      "minLength": 1
                    },
                    "dimension": {
                      "type": "string",
                      "const": "estructura"
                    },
                    "tipo_seccion": {
                      "type": "string",
                      "const": "remate"
                    },
                    "nombre": {
                      "type": "string",
                      "minLength": 1
                    },
                    "n_versos": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 2147483647
                    },
                    "posicion": {
                      "type": "string",
                      "const": "final"
                    }
                  },
                  "required": [
                    "literal",
                    "dimension",
                    "tipo_seccion",
                    "nombre",
                    "n_versos",
                    "posicion"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "literal": {
                      "type": "string",
                      "minLength": 1
                    },
                    "dimension": {
                      "type": "string",
                      "const": "asonancia"
                    }
                  },
                  "required": [
                    "literal"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "desviaciones": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "v_ini": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 2147483647
                },
                "v_fin": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 2147483647
                },
                "dimension": {
                  "type": "string",
                  "enum": [
                    "metro",
                    "estructura"
                  ]
                },
                "relacion_norma": {
                  "type": "string",
                  "enum": [
                    "menor_que_norma",
                    "mayor_que_norma",
                    "sobra",
                    "falta",
                    "otra"
                  ]
                },
                "metro_observado_slug": {
                  "type": "string",
                  "minLength": 1
                },
                "nota_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "texto_fuente": {
                  "type": "string",
                  "minLength": 1
                },
                "nota": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "v_ini",
                "v_fin",
                "dimension",
                "relacion_norma",
                "nota_ref",
                "texto_fuente",
                "nota"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "ref",
          "v_ini",
          "v_fin",
          "segmentacion",
          "origen",
          "identificacion",
          "candidatas",
          "regla_id",
          "nota",
          "detalles_fuente",
          "desviaciones"
        ],
        "additionalProperties": false
      }
    },
    "procedencia": {
      "type": "object",
      "properties": {
        "reglas_version": {
          "type": "string",
          "minLength": 1
        },
        "catalogo_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "extraccion_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "entradas_sha256": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "required": [
        "reglas_version",
        "catalogo_revision",
        "extraccion_sha256",
        "entradas_sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "esquema",
    "obra_ref",
    "metadatos",
    "jornadas",
    "segmentos",
    "procedencia"
  ],
  "additionalProperties": false
}
