  "notas": [
    {"id": "n01", "marca": "2", "texto_literal": "He seguido a Morley y Bruerton en llamar liras de seis versos los vv. 700-735 y 2612-2635, para evitar confusiones con la verdadera sextina petrarquista que no empleó Lope.", "fuente_id": "p073.jpg", "pagina": 73, "tramos_ref": ["t07", "t30"], "v_ini": null, "v_fin": null},
    {"id": "n02", "marca": "3", "texto_literal": "Sobre la octava (vv. 2484-2491) cuya existencia van Dam negó, véase mi nota a esos versos.", "fuente_id": "p074.jpg", "pagina": 74, "tramos_ref": ["t27"], "v_ini": 2484, "v_fin": 2491}
