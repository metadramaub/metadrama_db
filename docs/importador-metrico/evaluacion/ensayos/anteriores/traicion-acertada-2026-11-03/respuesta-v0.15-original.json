  "notas": [
    {
      "id": "n01",
      "marca": "21",
      "texto_literal": "Hemos considerado como quintillas las estrofas comprendidas entre los versos 914-1013, 1676-1725 y 2677-2861. Morley y Bruerton (Cronología, p. 108) han observado que los tipos de quintillas más frecuentes en las comedias de Lope «son el 1 [ababal y el 5 [aabbaj, algunas veces en forma de copla real de 1 y 5, pero mezcladas más frecuentemente de un modo irregular con algunas quintillas",
      "fuente_id": "25_traicion_acertada_1.HEIC",
      "pagina": null,
      "tramos_ref": [
        "t19"
      ],
      "v_ini": 914,
      "v_fin": 2861
    }
