  "notas": [
    {
      "id": "n01",
      "marca": "18",
      "texto_literal": "Como es habitual, la serie de tercetos encadenados se cierra con un serventesio final.",
      "fuente_id": "4_favor_agradecido_1.HEIC",
      "pagina": null,
      "tramos_ref": [
        "t02"
      ],
      "v_ini": null,
      "v_fin": null
    },
    {
      "id": "n02",
      "marca": "19",
      "texto_literal": "Se trata generalmente de formas cruzadas ababa (115) y formas aabba (125). [ilegible]tidas casi de manera igualitaria, salvo por una ocurrencia de abaab (5).",
      "fuente_id": "4_favor_agradecido_1.HEIC",
      "pagina": null,
      "tramos_ref": [
        "t03"
      ],
      "v_ini": null,
      "v_fin": null
    },
    {
      "id": "n03",
      "marca": "20",
      "texto_literal": "La serie está rematada por un pareado en vv. 888-889.",
      "fuente_id": "4_favor_agradecido_1.HEIC",
      "pagina": null,
      "tramos_ref": [
        "t04"
      ],
      "v_ini": 888,
      "v_fin": 889
    },
    {
      "id": "n04",
      "marca": "21",
      "texto_literal": "Los vv. 1056-1109 incluyen rimas internas.",
      "fuente_id": "4_favor_agradecido_1.HEIC",
      "pagina": null,
      "tramos_ref": [
        "t07"
      ],
      "v_ini": 1056,
      "v_fin": 1109
    },
    {
      "id": "n05",
      "marca": "22",
      "texto_literal": "La estructura es la siguiente: AaBbCC. Morley y Bruerton [1968:74] ser [ilegible]gularidad.",
      "fuente_id": "4_favor_agradecido_1.HEIC",
      "pagina": null,
      "tramos_ref": [
        "t08"
      ],
      "v_ini": null,
      "v_fin": null
    },
    {
      "id": "n06",
      "marca": "23",
      "texto_literal": "Estrofas con rima ababa (95) y con rima aabba (90).",
      "fuente_id": "4_favor_agradecido_2.HEIC",
      "pagina": 911,
      "tramos_ref": [
        "t09"
      ],
      "v_ini": null,
      "v_fin": null
    },
    {
      "id": "n07",
      "marca": "24",
      "texto_literal": "La serie está rematada por un pareado en vv. 1412-1413.",
      "fuente_id": "4_favor_agradecido_2.HEIC",
      "pagina": 911,
      "tramos_ref": [
        "t11"
      ],
      "v_ini": 1412,
      "v_fin": 1413
    },
    {
      "id": "n08",
      "marca": "25",
      "texto_literal": "Se trata de una serie de endecasílabos esdrújulos, cerrada por un pareado con rima llana (vv. 2175-2176).",
      "fuente_id": "4_favor_agradecido_2.HEIC",
      "pagina": 911,
      "tramos_ref": [
        "t18"
      ],
      "v_ini": 2175,
