// ============================================
// BASE DE DATOS: MÃƒÂ©trica del teatro ÃƒÂ¡ureo
// Proyecto METADRAMA
// VersiÃƒÂ³n: 3.1 - Comentarios internos + AnÃƒÂ¡lisis
// ============================================




// ============================================
// EDITORES (vinculado a Supabase Auth)
// ============================================



Table editores {
  user_id uuid [pk, note: 'Referencia a auth.users(id) de Supabase']
  nombre_completo varchar(200) [not null, note: 'Nombre del editor']
  email varchar(255) [not null, unique, note: 'Email (sincronizado con auth.users)']
  
  // PERMISOS Y ROL
  role uuid [not null, ref: > vocabularios.termino_id, note: 'UUID de vocabulario categorÃƒÂ­a role_editor: editor, revisor, admin, IP']
  activo bool [default: true, note: 'FALSE = desactivado temporalmente']
  
  // PERFIL ACADÃƒâ€°MICO
  institucion varchar(200) [note: 'Universidad o centro de investigaciÃƒÂ³n']
  orcid varchar(20) [note: 'ORCID ID del investigador']
  
  // METADATOS
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  last_login timestamp [note: 'ÃƒÅ¡ltima vez que iniciÃƒÂ³ sesiÃƒÂ³n']
  
  indexes {
    email
    role
    activo
  }
  
  Note: 'user_id debe coincidir con auth.users(id). Supabase Auth gestiona contraseÃƒÂ±as y autenticaciÃƒÂ³n'
}




// ============================================
// AUTORES
// ============================================



Table autores {
  autor_id uuid [pk]
  nombre_completo varchar(200) [not null, note: 'Nombre canÃƒÂ³nico: "Juan Bautista Diamante"']
  nombre_normalizado varchar(200) [note: 'Para ordenaciÃƒÂ³n: "Diamante, Juan Bautista"']
  variantes_nombre text[] [note: 'Array de variantes: ["Diamante", "J.B. Diamante"]']
  bnedatos_id varchar(20) [note: 'BNEDatos ID']
  viaf_id varchar(20) [note: 'Virtual International Authority File']
  wikidata_id varchar(20) [note: 'Wikidata ID (Q...)']
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  indexes {
    nombre_normalizado
  }
}




// ============================================
// OBRAS
// ============================================



Table obras {
  obra_id uuid [pk]
  
  // TÃƒÂTULO
  titulo text [not null, note: 'TÃƒÂ­tulo principal para mostrar: "La dama boba"']
  titulo_normalizado text [note: 'TÃƒÂ­tulo con artÃƒÂ­culo al final para ordenaciÃƒÂ³n: "dama boba, La"']
  variantes_titulo text[] [note: 'Array de tÃƒÂ­tulos alternativos histÃƒÂ³ricos']
  
  // DATACIÃƒâ€œN TRADICIONAL
  fecha_inicio_trad int [note: 'AÃƒÂ±o inicio del rango de dataciÃƒÂ³n tradicional: 1613']
  fecha_fin_trad int [note: 'AÃƒÂ±o fin del rango de dataciÃƒÂ³n tradicional: 1617']
  fuente_fecha text [note: 'Referencia bibliogrÃƒÂ¡fica de la dataciÃƒÂ³n: "Morley & Bruerton (1968)"']
  
  // DATACIÃƒâ€œN PROYECTO METADRAMA
  fecha_inicio_metadrama int [note: 'AÃƒÂ±o inicio propuesto por proyecto (NULL hasta tener datos)']
  fecha_fin_metadrama int [note: 'AÃƒÂ±o fin propuesto por proyecto (NULL hasta tener datos)']
  
  // EDICIÃƒâ€œN BASE
  edicion text [note: 'EdiciÃƒÂ³n usada por el editor: "Parte IX (1617), ed. Profeti (2007)"']
  
  // AUTORÃƒÂA (se declara en tablas rangos + rangos_autores)
  autoria text[] [note: 'Array calculado de nombres de autores (para mostrar en listados). Se genera automÃƒÂ¡ticamente desde rangos_autores']
  url_informe_autoria text [note: 'URL externa a anÃƒÂ¡lisis estilomÃƒÂ©trico ETSO que justifica las decisiones de autorÃƒÂ­a (TAB: AutorÃƒÂ­a)']
  
  // ASIGNACIÃƒâ€œN Y GESTIÃƒâ€œN
  editor_asignado uuid [ref: > editores.user_id, note: 'Editor responsable de esta obra']
  fecha_asignacion timestamp [note: 'CuÃƒÂ¡ndo se asignÃƒÂ³ al editor actual']
  
  // ESTADOS Y VISIBILIDAD (TAB: RevisiÃƒÂ³n)
  estado uuid [not null, ref: > vocabularios.termino_id, note: 'UUID de vocabulario: borrador, pendiente, en_revision, validado, publicado']
  visible_publico bool [default: false, note: 'TRUE = visible sin login en web pÃƒÂºblica (solo si estado=publicado; solo admin/IP)']
  fecha_cambio_estado timestamp [note: 'ÃƒÅ¡ltima vez que cambiÃƒÂ³ el estado']
  
  // ANÃƒÂLISIS Y BIBLIOGRAFÃƒÂA (TAB: AnÃƒÂ¡lisis)
  analisis_editor text [note: 'AnÃƒÂ¡lisis pÃƒÂºblico del editor con formato rico/markdown. Visible en web pÃƒÂºblica']
  bibliografia text [note: 'Referencias bibliogrÃƒÂ¡ficas generales sobre la obra. Texto largo']
  
  // METADATOS GENERALES
  genero_id uuid [ref: > vocabularios.termino_id, note: 'UUID del tÃƒÂ©rmino: comedia, tragedia, auto sacramental']
  total_versos int [note: 'Calculado: MAX(v_fin) de la ÃƒÂºltima jornada de la obra']
  
  // TIMESTAMPS
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  indexes {
    titulo_normalizado
    estado
    visible_publico
    editor_asignado
  }
  
  Note: 'Comentarios internos de trabajo ahora en tabla comentarios_internos (historial con usuario y fecha)'
}




// ============================================
// COMENTARIOS INTERNOS (nuevo - historial)
// ============================================



Table comentarios_internos {
  comentario_id uuid [pk]
  obra_id uuid [ref: > obras.obra_id, note: 'Obra a la que pertenece el comentario']
  user_id uuid [ref: > editores.user_id, note: 'Editor/revisor que escribiÃƒÂ³ el comentario']
  comentario text [not null, note: 'Texto del comentario interno']
  created_at timestamp [default: `now()`, note: 'Fecha de creaciÃƒÂ³n del comentario']
  
  indexes {
    obra_id
    user_id
    created_at [note: 'DESC para mostrar mÃƒÂ¡s recientes primero']
  }
  
  Note: 'Historial de comentarios internos entre editores y revisores. NO visible en web pÃƒÂºblica. Reemplaza campo observaciones_internas de obras'
}




// ============================================
// JORNADAS (estructura de obra)
// ============================================



Table jornadas {
  jornada_id uuid [pk]
  obra_id uuid [ref: > obras.obra_id, note: 'Jornada pertenece a obra']
  jornada_num int [not null, note: 'NÃƒÂºmero de jornada: 1, 2, 3...']
  v_ini int [not null, note: 'Verso inicial de la jornada']
  v_fin int [not null, note: 'Verso final de la jornada']
  
  indexes {
    (obra_id, jornada_num) [unique]
    obra_id
  }
  
  Note: 'DivisiÃƒÂ³n estructural formal de la obra. AutorÃƒÂ­a se declara en rangos/rangos_autores'
}




// ============================================
// CUADROS (divisiones dramÃƒÂ¡ticas)
// ============================================



Table cuadros {
  cuadro_id uuid [pk]
  jornada_id uuid [ref: > jornadas.jornada_id, note: 'Cuadro pertenece a jornada']
  cuadro_num int [not null, note: 'NÃƒÂºmero de cuadro dentro de jornada: 1, 2, 3...']
  v_ini int [not null, note: 'Verso inicial del cuadro']
  v_fin int [not null, note: 'Verso final del cuadro']
  descripcion text [note: 'Texto libre: espacio, acciÃƒÂ³n ("JardÃƒÂ­n nocturno", "Escena de engaÃƒÂ±o")']
  certeza_editor uuid [not null, ref: > vocabularios.termino_id, note: 'UUID de vocabulario: baja, media, alta']
  
  indexes {
    (jornada_id, cuadro_num) [unique]
    jornada_id
  }
  
  Note: 'Se revisa junto con la obra, sin estado independiente'
}




// ============================================
// SECUENCIAS MÃƒâ€°TRICAS (unidad de anÃƒÂ¡lisis)
// ============================================



Table secuencias_metricas {
  secuencia_id uuid [pk]
  obra_id uuid [ref: > obras.obra_id]
  
  // LOCALIZACIÃƒâ€œN (jornada/cuadro se infieren desde v_ini/v_fin)
  v_ini int [not null, note: 'Verso inicial']
  v_fin int [not null, note: 'Verso final']
  n_versos int [not null, note: 'Calculado: v_fin - v_ini + 1']
  
  // CLASIFICACIÃƒâ€œN MÃƒâ€°TRICA (metros se deducen por estrofa_tipo en estrofa_tipo_metros)
  estrofa_tipo_id uuid [ref: > vocabularios.termino_id, note: 'romance, quintilla (ababa), redondilla, combinaciÃƒÂ³n_libre']
  
  // ESPACIO DRAMÃƒÂTICO
  inaugura_espacio bool [default: false, note: 'TRUE si hay cambio de lugar fÃƒÂ­sico']
  
  // PERSONAJES
  personajes_genero varchar(20) [not null, default: 'mixto', note: 'mixto, solo_masculino, solo_femenino']
  personajes_donaire varchar(20) [not null, default: 'ausente', note: 'ausente, solo, con_otros']
  personajes_sobrenatural varchar(20) [not null, default: 'ausente', note: 'ausente, solo, con_otros']
  
  // CALIDAD EDITORIAL
  certeza_editor uuid [not null, ref: > vocabularios.termino_id, note: 'UUID de vocabulario: baja, media, alta - obligatorio']
  
  // OBSERVACIONES
  observaciones text [note: 'Observaciones pÃƒÂºblicas: variantes, contexto dramÃƒÂ¡tico']
  notas_internas text [note: 'Problemas por revisar, dudas del editor - NO pÃƒÂºblicas']
  
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  indexes {
    obra_id
    v_ini
    estrofa_tipo_id
  }
  
  Note: 'Unidad de anÃƒÂ¡lisis mÃƒÂ©trico. AutorÃƒÂ­a se consulta desde rangos/rangos_autores por overlap de versos. Metros se deducen por estrofa_tipo en estrofa_tipo_metros'
}




// ============================================
// RANGOS DE VERSOS (autorÃƒÂ­a)
// ============================================



Table rangos {
  rango_id uuid [pk]
  obra_id uuid [ref: > obras.obra_id]
  v_ini int [not null, note: 'Verso inicial del rango']
  v_fin int [not null, note: 'Verso final del rango']
  notas text [note: 'Observaciones del editor sobre este rango (opcional)']
  
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  indexes {
    obra_id
    (obra_id, v_ini, v_fin)
  }
  
  Note: 'Rangos continuos de versos con la misma autorÃƒÂ­a. Un rango puede tener 1 autor (ÃƒÂºnico) o mÃƒÂºltiples (colaborada sin determinar). Los editores NO ven la palabra "rango", solo definen autorÃƒÂ­a por obra completa/por jornadas/personalizado'
}




// ============================================
// AUTORES DE CADA RANGO
// ============================================



Table rangos_autores {
  rango_id uuid [ref: > rangos.rango_id]
  autor_id uuid [ref: > autores.autor_id]
  
  indexes {
    (rango_id, autor_id) [pk]
    rango_id
    autor_id
  }
  
  Note: '1 fila por rango = autorÃƒÂ­a ÃƒÂºnica. 2+ filas por rango = autorÃƒÂ­a mÃƒÂºltiple (obra colaborada sin determinar quiÃƒÂ©n escribiÃƒÂ³ cada parte)'
}




// ============================================
// METROS POR ESTROFA TIPO
// ============================================



Table estrofa_tipo_metros {
  estrofa_tipo_id uuid [ref: > vocabularios.termino_id, note: 'Debe ser categoria estrofa_tipo']
  metro_id uuid [ref: > vocabularios.termino_id, note: 'Debe ser categoria metro']
  created_at timestamp [default: `now()`]

  indexes {
    (estrofa_tipo_id, metro_id) [pk]
    metro_id
  }

  Note: 'Declara metros posibles para cada estrofa_tipo. Las secuencias ya no guardan metros propios'
}



// ============================================
// VARIACIONES DENTRO DE SECUENCIAS
// ============================================



Table secuencias_variaciones {
  variacion_id uuid [pk]
  secuencia_id uuid [ref: > secuencias_metricas.secuencia_id]
  tipo_variacion varchar(20) [not null, note: 'cantado, (otros tipos a definir)']
  v_ini int [not null, note: 'Verso inicial de la variaciÃƒÂ³n']
  v_fin int [not null, note: 'Verso final de la variaciÃƒÂ³n']
  observaciones text
  
  indexes {
    secuencia_id
    tipo_variacion
  }
  
  Note: 'Para marcar versos cantados u otras variaciones dentro de secuencias'
}




// ============================================
// VOCABULARIOS CONTROLADOS (con jerarquÃƒÂ­a)
// ============================================



Table vocabularios {
  termino_id uuid [pk]
  categoria varchar(50) [not null, note: 'metro, estrofa_tipo, genero, estado, certeza_editor, personajes_genero, personajes_donaire, personajes_sobrenatural, role_editor']
  termino varchar(100) [not null, note: 'TÃƒÂ©rmino preferido']
  
  // JERARQUÃƒÂA (solo para tÃƒÂ©rminos que la necesiten)
  termino_padre_id uuid [ref: > vocabularios.termino_id, note: 'NULL si no tiene padre']
  nivel int [note: 'NULL o 1=raÃƒÂ­z, 2=variante']

  patron_especifico varchar(50) [note: 'NULL si no aplica. Ej: "ababa", "e-o"']
  tipo_forma varchar(30) [note: 'Solo para estrofa_tipo: forma_espanola o forma_italiana']
  
  // METADATOS
  definicion text
  ejemplo text
  equivalencias text[] [note: 'Array de sinÃƒÂ³nimos o variantes']
  orden int [note: 'Para ordenar en dropdowns']
  activo boolean [default: true]
  bibliografia text
  
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  indexes {
    (categoria, termino) [unique]
    categoria
    termino_padre_id
    activo
  }
  
  Note: 'Vocabulario ÃƒÂºnico con jerarquÃƒÂ­a opcional. Incluye role_editor para roles del sistema'
}
