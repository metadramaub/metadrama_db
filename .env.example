PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_PROJECT_REF=your-project-ref
GLOBAL_ACCESS_PASSWORD=your-private-preview-password
# Solo servidor: necesaria para alta, perfiles e invitaciones de editores.
# Nunca utilizar un prefijo PUBLIC_ o VITE_ para esta clave.
SUPABASE_SERVICE_ROLE_KEY=your-private-service-role-key

# Backward compatible aliases requested in initial project notes
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Carpeta de OneDrive para lo que no va por git (bibliografía, fotos del importador).
# Si no se define, se usa OneDriveCommercial\Investigacion\versologia-data-sync.
# VERSOLOGIA_SYNC_DIR=C:\Users\usuario\OneDrive - UAB\Investigacion\versologia-data-sync
