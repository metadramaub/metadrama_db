      "v_ini": 1,
      "v_fin": 184,
      "espacio": "Portal de una posada en Illescas",
      "personajes_al_entrar": [
        "LISEO",
        "TURÍN"
      ],
      "justificacion": "Tras el v. 184 la acotación «Éntrense» saca a los dos únicos personajes en escena; a continuación salen Otavio y Miseno, ya en Madrid.",
      "seguridad": "clara"
    },
    {
      "numero": 2,
      "jornada": 1,
      "v_ini": 185,
      "v_fin": 1062,
      "espacio": "Sala en casa de Otavio, en Madrid",
      "personajes_al_entrar": [
        "OTAVIO",
        "MISENO"
      ],
      "justificacion": "Los personajes se suceden sin que el tablado quede vacío. El acto termina en el v. 1062 con Liseo y Turín todavía en escena, así que el cuadro se cierra por fin de jornada, no por vaciado.",
      "seguridad": "clara"
    },
    {
      "numero": 3,
      "jornada": 2,
      "v_ini": 1063,
      "v_fin": 1364,
      "espacio": "Sala que da a un parque, en casa de Otavio",
      "personajes_al_entrar": [
        "DUARDO",
        "LAURENCIO",
        "FENISO"
      ],
      "justificacion": "Laurencio se queda solo en escena y sale con «Vase» tras el v. 1364; el tablado queda vacío antes de que entren el maestro de danzar y Finea.",
      "seguridad": "clara"
    },
    {
      "numero": 4,
      "jornada": 2,
      "v_ini": 1365,
      "v_fin": 1581,
      "espacio": null,
      "personajes_al_entrar": [
        "MAESTRO DE DANZAR",
        "FINEA"
      ],
      "justificacion": "Clara y Finea salen juntas con «Váyanse» tras el v. 1581, y el cuadro siguiente empieza en el campo con Liseo y Laurencio.",
      "seguridad": "clara"
    },
    {
      "numero": 5,
      "jornada": 2,
      "v_ini": 1582,
      "v_fin": 1669,
      "espacio": "El campo, cerca de los Recoletos Agustinos",
      "personajes_al_entrar": [
        "LISEO",
        "LAURENCIO"
      ],
      "justificacion": "Tras el desafío frustrado, el «Vanse» del v. 1669 saca a los cuatro presentes (Otavio, Turín, Liseo y Laurencio); lo siguiente ocurre en casa de Otavio con Nise y Finea.",
      "seguridad": "clara"
    },
    {
      "numero": 6,
      "jornada": 2,
      "v_ini": 1670,
      "v_fin": 2034,
      "espacio": "Sala en casa de Otavio",
      "personajes_al_entrar": [
        "NISE",
        "FINEA"
      ],
      "justificacion": "Siempre queda alguien en escena de la situación anterior. El acto termina en el v. 2034 con Liseo y Laurencio dialogando, así que el cuadro se cierra por fin de jornada.",
      "seguridad": "clara"
    },
    {
      "numero": 7,
      "jornada": 3,
      "v_ini": 2035,
      "v_fin": 2092,
      "espacio": null,
      "personajes_al_entrar": [
        "FINEA"
      ],
      "justificacion": "El acto abre con Finea sola y entra Clara. No hay acotación de salida: el vaciado se deduce de que lo siguiente arranca con Miseno y Otavio, elenco enteramente distinto.",
      "seguridad": "dudosa"
    },
    {
      "numero": 8,
      "jornada": 3,
      "v_ini": 2093,
      "v_fin": 2932,
      "espacio": "Casa de Otavio",
      "personajes_al_entrar": [
        "MISENO",
        "OTAVIO"
      ],
      "justificacion": "Tras el «Éntrense todos» del v. 2328 quedan Liseo y Turín, y más adelante Laurencio y Pedro permanecen escondidos sin salir del tablado. El cuadro acaba cuando Liseo y Turín, únicos en escena, salen con «Váyanse» tras el v. 2932.",
      "seguridad": "clara"
    },
    {
      "numero": 9,
      "jornada": 3,
      "v_ini": 2933,
      "v_fin": 3186,
      "espacio": "Casa de Otavio: la sala y el desván",
      "personajes_al_entrar": [
        "FINEA",
        "CLARA"
      ],
      "justificacion": "Desde la entrada de Finea y Clara el elenco solo crece, hasta el desenlace y el verso final de la comedia (v. 3186).",
      "seguridad": "clara"
    }
  ],
