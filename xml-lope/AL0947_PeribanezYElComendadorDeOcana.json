      "v_fin": 662,
      "espacio": "Casa del Comendador en Ocaña",
      "personajes_al_entrar": [
        "EL COMENDADOR",
        "LEONARDO"
      ],
      "justificacion": "El «Váyanse» del v. 523 no vacía la escena: el Comendador sigue hablando solo sin entrada nueva, señal de que solo salió Leonardo. Tras el v. 662, «Váyanse» sí la vacía.",
      "seguridad": "dudosa"
    },
